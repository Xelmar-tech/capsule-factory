    }
  ],
  "runtime_terms": [
    {
      "claude": "TeamCreate",
      "codex": "parent Codex session spawns custom subagents"
    },
    {
      "claude": "SendMessage",
      "codex": "parent Codex session sends scoped prompts to subagents"
    },
    {
      "claude": "TaskOutput",
      "codex": "parent Codex session waits for and summarizes subagent results"
    },
    {
      "claude": "agents/*.md",
      "codex": ".codex/agents/*.toml copied from plugin codex-agents templates"
    },
    {
      "claude": "commands/*.md slash commands",
      "codex": "skills invoked with $skill names and plugin default prompts"
    }
  ]
